# ── Supabase (frontend — safe to expose in browser) ─────────────────────────
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_key

# ── Optional: Google Analytics 4 funnel events ──────────────────────────────
# VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# ── Optional: legacy single-shot composite (hits WORKER_RESOURCE_LIMIT) ─────
# VITE_COMPOSITE_FULL_PIPELINE=true

# ── Edge function secrets go in Supabase Dashboard ──────────────────────────
# Edge Functions → Secrets (NOT in .env.local):
#
#   REPLICATE_API_TOKEN=r8_...            # from https://replicate.com/account/api-tokens
#   REPLICATE_WEBHOOK_SECRET=...          # random string; protects /functions/v1/replicate-webhook
#                                         # generate: openssl rand -hex 32
#   REPLICATE_USE_GFPGAN=false            # keep false — extra Replicate pass busts CPU limit
#   RESEND_API_KEY=re_...                 # optional, for result email delivery
#   RESEND_FROM=SWAARM in the Chorus <promotion@swaarmglobal.com>
#
# Optional override (defaults to ${SUPABASE_URL}/functions/v1):
#   REPLICATE_WEBHOOK_BASE_URL=https://your-tunnel.example.com/functions/v1
#
# Also add to .env.local for scripts (upload:campaign):
#   SUPABASE_SERVICE_ROLE_KEY=eyJ...
#
# Deploy edge functions:
#   supabase functions deploy composite-image selfie-upload-url
#   supabase functions deploy replicate-webhook --no-verify-jwt
#   supabase functions deploy send-result-email   # optional email
