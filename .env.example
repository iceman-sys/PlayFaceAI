# ── Supabase (frontend — safe to expose in browser) ─────────────────────────
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_key

# ── Optional: Google Analytics 4 funnel events ──────────────────────────────
# VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# ── Gemini + email secrets go in Supabase Dashboard ─────────────────────────
# Edge Functions → Secrets (NOT in .env.local):
#   GEMINI_API_KEY=AIza...your_key_from_https://aistudio.google.com/app/apikey
#   Do NOT use OAuth client secrets. For server (Supabase) calls, set key restrictions to "None" or allow server IPs.
#   GEMINI_HARMONIZE=true
#   GEMINI_MODEL=gemini-2.5-flash-image
#   GEMINI_MODEL=gemini-3.1-flash-image-preview  # optional: 2K output for sharper results
#   RESEND_API_KEY=re_...
#   RESEND_FROM=SWAARM in the Chorus <promotion@swaarmglobal.com>
#
# Deploy:
#   supabase functions deploy composite-image
#   supabase functions deploy send-result-email
