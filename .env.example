# ─── Client (Vite — exposed to browser) ───
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Production: URL of your deployed generate API (skip in dev — Vite plugin handles it)
# VITE_GENERATE_API_URL=https://your-api.example.com/api/generate-sports-portrait

# ─── AI generation (server only) ───
# gemini = recommended (2-pass face → headgear → harmonize)
IMAGE_PROVIDER=gemini
GEMINI_API_KEY=your-key-from-aistudio.google.com
GEMINI_MODEL=gemini-2.5-flash-image
GEMINI_TWO_PASS=true
GEMINI_HARMONIZE=true

# hybrid = OpenAI 2-pass (requires OPENAI_API_KEY)
# pipeline = local geometric compositor (no API cost)

# Optional OpenAI fallback if pipeline fails, and optional final harmonize pass:
OPENAI_API_KEY=sk-your-key-here
# OPENAI_HARMONIZE=true

# Legacy single-pass OpenAI settings (IMAGE_PROVIDER=openai):
OPENAI_IMAGE_MODEL=gpt-image-1
OPENAI_IMAGE_SIZE=1536x1024
OPENAI_IMAGE_QUALITY=high

# Pipeline tuning (optional)
# PIPELINE_FACE_SCALE=0.97
# PIPELINE_GRAIN=0.04
# Optional Gemini (auto-falls back to OpenAI on geo/quota errors if OPENAI_API_KEY is set)
# IMAGE_PROVIDER=gemini
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash-image

# ─── Supabase Storage (server — service role, NEVER expose to client) ───
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_STORAGE_BUCKET=campaign-results

# ─── Optional email delivery (Resend) ───
# RESEND_API_KEY=re_...
# RESEND_FROM=SWAARM Campaign <onboarding@resend.dev>

# ─── Standalone server (npm run server) ───
# PORT=3001
# PUBLIC_ORIGIN=https://your-api.example.com
